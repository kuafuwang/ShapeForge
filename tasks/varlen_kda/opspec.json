{
  "spec_version": 2,
  "op_name": "varlen_kda",
  "category": "attention",
  "formula": "packed-varlen Kimi Delta Attention forward: per-sequence chunked per-channel-gated delta rule (q/k L2 norm, per-channel log-decay, delta residual, fp32 V-first recurrent state per sequence)",
