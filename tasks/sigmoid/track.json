{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/sigmoid/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-sigmoid",
  "spec_text": {
    "template": "tasks/sigmoid/kernel_triton.py",
    "placeholders": {
      "N": "spec_params",
      "BLOCK_SIZE": "backend_params",
      "NUM_WARPS": "backend_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/sigmoid/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "y[i] = 1 / (1 + exp(-x[i])), evaluated in fp32 and rounded to the element type once.",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "sigmoid.gen_inputs",
      "implementation_version": 1,
      "params": {
        "normal_mag": 3.0,
        "default_mag": 1.0,
        "large": 10000.0,
        "seed_stride": 1000003
      }
    },
    "reference": {
      "implementation_id": "sigmoid.reference",
      "implementation_version": 1,
      "params": {
        "op": "sigmoid",
        "accumulate": "float64"
      }
    },
    "error_scale": null
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "sigmoid.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "mx.sigmoid"
      }
    },
    {
      "name": "torch_mps",
      "framework": "torch",
      "implementation_id": "sigmoid.baseline.torch_mps",
      "implementation_version": 1,
      "params": {
        "kernel": "torch.sigmoid"
      }
    }
  ],
  "pack_files": [
    "tasks/_assembly.py",
    "tasks/_common.py",
    "tasks/_pointwise.py",
    "tasks/sigmoid/__init__.py",
    "tasks/sigmoid/kernel_triton.py",
    "tasks/sigmoid/naive.metal",
    "tasks/sigmoid/opspec.json",
    "tasks/sigmoid/task.py",
    "tasks/sigmoid/track.json",
    "tcenv/backends/metal/lowering.py",
    "tcenv/contract.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/task.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json"
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/sigmoid/kernel_triton.py",
        "text": "num_warps = 4",
        "threads_per_threadgroup": 128
      },
      {
        "template": "tasks/sigmoid/naive.metal",
        "text": "i += 128",
        "threads_per_threadgroup": 128
      }
    ],
    "semantic": []
  }
}
