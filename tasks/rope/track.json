{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/rope/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-rope",
  "spec_text": {
    "template": "tasks/rope/kernel_triton.py",
    "placeholders": {
      "B": "spec_params",
      "H": "spec_params",
      "S": "spec_params",
      "D": "spec_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/rope/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "Rotary position embedding on x[B,H,S,D], position = index along S, frequencies BASE^(-i/(D/2)), pairs (x[..., i], x[..., i + D/2]) are rotated by angle pos*freq_i. Angles/trig are computed on the fly in fp32 (no tables).",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "rope.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mags": {
          "normal": 1.0,
          "wide_range": 1.0
        },
        "default_mag": 1.0,
        "large": 40000.0
      }
    },
    "reference": {
      "implementation_id": "rope.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "float64",
        "base_attr": "BASE",
        "layout": "half_split"
      }
    },
    "error_scale": null
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "rope.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "mx.fast.rope",
        "traditional": false,
        "base_attr": "BASE",
        "scale": 1.0,
        "offset": 0
      }
    }
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/rope/kernel_triton.py",
        "text": "num_warps = 4",
        "threads_per_threadgroup": 128
      },
      {
        "template": "tasks/rope/naive.metal",
        "text": "i += 128",
        "threads_per_threadgroup": 128
      }
    ],
    "semantic": [
      {
        "template": "tasks/rope/kernel_triton.py",
        "text": "BASE = 10000.0",
        "attr": "BASE"
      }
    ]
  },
  "pack_files": [
    "tasks/_assembly.py",
    "tasks/_common.py",
    "tasks/rope/__init__.py",
    "tasks/rope/kernel_triton.py",
    "tasks/rope/naive.metal",
    "tasks/rope/opspec.json",
    "tasks/rope/task.py",
    "tasks/rope/track.json",
    "tcenv/backends/metal/lowering.py",
    "tcenv/contract.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/task.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json"
  ]
}
