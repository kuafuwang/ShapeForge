{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/softmax/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-softmax",
  "spec_text": {
    "template": "tasks/softmax/kernel_triton.py",
    "placeholders": {
      "M": "spec_params",
      "N": "spec_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/softmax/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "Numerically stable row-wise softmax: y = exp(x - max(x)) / sum(exp(x - max(x))); statistics in fp32, result rounded once.",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "softmax.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mags": {
          "normal": 2.0
        },
        "default_mag": 1.0,
        "large": 10000.0
      }
    },
    "reference": {
      "implementation_id": "softmax.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "float64",
        "dim": "last"
      }
    },
    "error_scale": null
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "softmax.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "mx.softmax",
        "axis": "last",
        "precise": true
      }
    },
    {
      "name": "torch_mps",
      "framework": "torch",
      "implementation_id": "softmax.baseline.torch_mps",
      "implementation_version": 1,
      "params": {
        "kernel": "torch.softmax",
        "dim": "last"
      }
    }
  ],
  "pack_files": [
    "tcenv/backends/metal/lowering.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json",
    "tasks/_assembly.py",
    "tasks/softmax/__init__.py",
    "tasks/softmax/kernel_triton.py",
    "tasks/softmax/naive.metal",
    "tasks/softmax/opspec.json",
    "tasks/softmax/task.py",
    "tasks/softmax/track.json"
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/softmax/kernel_triton.py",
        "text": "num_warps = 8",
        "threads_per_threadgroup": 256
      },
      {
        "template": "tasks/softmax/naive.metal",
        "text": "i += 256",
        "threads_per_threadgroup": 256
      }
    ],
    "semantic": []
  }
}
