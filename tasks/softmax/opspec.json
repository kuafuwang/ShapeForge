{
  "spec_version": 2,
  "op_name": "softmax",
  "category": "normalization",
  "formula": "y[r,c] = exp(x[r,c] - max_c x[r,c]) / sum_c exp(x[r,c] - max_c x[r,c])",
  "type_vars": {
    "T": [
      "fp16",
      "bf16"
    ]
  },
  "symbols": {
    "M": {
      "min": 0
    },
    "N": {
      "min": 1
    }
  },
  "tensors": {
    "x": {
      "role": "input",
      "dims": [
        "M",
        "N"
      ],
      "dtype": "T",
      "layout": "row_major",
      "strides": [
        "N",
        "1"
      ],
      "space": "global",
      "access": "read",
      "doc": "logits, row-major [M, N]"
    },
    "y": {
      "role": "output",
      "dims": [
        "M",
        "N"
      ],
      "dtype": "T",
      "layout": "row_major",
      "strides": [
        "N",
        "1"
      ],
      "space": "global",
      "access": "write"
    }
  },
  "numerics": {
    "acc_dtype": "fp32",
    "rounding": "single_round_at_output",
    "tolerances": {
      "fp16": {
        "rtol": 0.002,
        "atol_rel": 0.001
      },
      "bf16": {
        "rtol": 0.016,
        "atol_rel": 0.008
      }
    },
    "exact": false
  },
  "attrs": {},
  "cases": {
    "names": [
      "normal",
      "wide_range",
      "large",
      "tiny",
      "outlier",
      "const",
      "ieee"
    ]
  },
  "sizes": {
    "paper": {
      "M": 8192,
      "N": 2048,
      "usage": [
        "golden",
        "benchmark"
      ]
    },
    "small": {
      "M": 64,
      "N": 512,
      "usage": [
        "golden",
        "benchmark"
      ]
    }
  },
  "spec_params": [
    "M",
    "N"
  ],
  "work_accounting": {
    "flops": {
      "terms": [
        {
          "coefficient": 5,
          "symbols": [
            "M",
            "N"
          ]
        }
      ]
    },
    "min_bytes": {
      "terms": [
        {
          "tensor": "x"
        },
        {
          "tensor": "y"
        }
      ]
    }
  },
  "discovery": {
    "phase": 1,
    "default_instance": {
      "dtype": "fp16",
      "size": "small"
    }
  }
}
