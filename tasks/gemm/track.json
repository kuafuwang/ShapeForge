{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/gemm/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-gemm",
  "spec_text": {
    "template": "tasks/gemm/kernel_triton.py",
    "placeholders": {
      "M": "spec_params",
      "N": "spec_params",
      "K": "spec_params",
      "BM": "backend_params",
      "BN": "backend_params",
      "BK": "backend_params",
      "NW": "backend_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/gemm/naive.metal",
    "placeholders": {
      "T": "dtype_spelling",
      "THREADS": "backend_params",
      "TM": "backend_params",
      "TPR": "backend_params"
    }
  },
  "description": "C = A @ B with row-major A[M,K], B[K,N], C[M,N]; fp32 accumulation, result rounded once.",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "gemm.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mags": {
          "normal": 1.0,
          "wide_range": 0.1
        },
        "default_mag": 1.0,
        "large": 20.0,
        "spike": 5.0,
        "seed_offsets": {
          "A": 0,
          "B": 31
        }
      }
    },
    "reference": {
      "implementation_id": "gemm.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "float64",
        "matmul": "float32_cpu",
        "epilogue": "identity"
      }
    },
    "error_scale": null
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "gemm.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "matmul"
      }
    },
    {
      "name": "torch_mps",
      "framework": "torch",
      "implementation_id": "gemm.baseline.torch_mps",
      "implementation_version": 1,
      "params": {
        "kernel": "torch.matmul"
      }
    }
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/gemm/kernel_triton.py",
        "text": "num_warps = {{NW}}",
        "threads_per_threadgroup": 128
      }
    ],
    "semantic": []
  },
  "variant_factory": "metal.gemm.variant",
  "baseline_variant": {
    "template": "tasks/gemm/kernel_triton_msl.py",
    "placeholders": {
      "M": "spec_params",
      "N": "spec_params",
      "K": "spec_params",
      "BM": "backend_params",
      "BN": "backend_params",
      "BK": "backend_params",
      "NW": "backend_params",
      "TL": "dtype_spelling"
    },
    "note": "program-id roles swapped, M/N/K as runtime scalars"
  },
  "pack_files": [
    "tasks/_assembly.py",
    "tasks/_common.py",
    "tasks/gemm/__init__.py",
    "tasks/gemm/kernel_triton.py",
    "tasks/gemm/naive.metal",
    "tasks/gemm/opspec.json",
    "tasks/gemm/task.py",
    "tasks/gemm/track.json",
    "tcenv/backends/metal/lowering.py",
    "tcenv/contract.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/task.py",
    "tcenv/terms.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json"
  ]
}
