{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/lion/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-lion",
  "spec_text": {
    "template": "tasks/lion/kernel_triton.py",
    "placeholders": {
      "N": "spec_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/lion/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "One Lion optimizer step: c = b1*m + (1-b1)*g; p_out = p*(1 - lr*wd) - lr*sign(c); m_out = b2*m + (1-b2)*g (fp32 math, each output rounded once).",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "lion.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mag": 1.0,
        "large": 1000.0,
        "seed_offset": 7,
        "tiny_non_fp16_scale": 1000.0,
        "inputs": [
          "p",
          "g",
          "m"
        ]
      }
    },
    "reference": {
      "implementation_id": "lion.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "float64",
        "attrs": [
          "LR",
          "WD",
          "BETA1",
          "BETA2"
        ]
      }
    },
    "error_scale": {
      "implementation_id": "lion.error_scale",
      "implementation_version": 1,
      "params": {
        "discontinuity_rel": 1e-05,
        "atol_steps": 2.5
      }
    }
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "lion.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "mx.compile",
        "expression": "simplified_lion_step"
      }
    },
    {
      "name": "torch_mps",
      "framework": "torch",
      "implementation_id": "lion.baseline.torch_mps",
      "implementation_version": 1,
      "params": {
        "kernel": "eager_ops"
      }
    },
    {
      "name": "torch_compile",
      "framework": "torch",
      "implementation_id": "lion.baseline.torch_compile",
      "implementation_version": 1,
      "params": {
        "kernel": "torch.compile",
        "expression": "eager_ops"
      }
    }
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/lion/kernel_triton.py",
        "text": "num_warps = 4",
        "threads_per_threadgroup": 128
      },
      {
        "template": "tasks/lion/naive.metal",
        "text": "i += 128",
        "threads_per_threadgroup": 128
      }
    ],
    "semantic": [
      {
        "template": "tasks/lion/kernel_triton.py",
        "text": "LR = 0.001",
        "attr": "LR"
      },
      {
        "template": "tasks/lion/kernel_triton.py",
        "text": "WD = 0.1",
        "attr": "WD"
      },
      {
        "template": "tasks/lion/kernel_triton.py",
        "text": "BETA1 = 0.9",
        "attr": "BETA1"
      },
      {
        "template": "tasks/lion/kernel_triton.py",
        "text": "BETA2 = 0.99",
        "attr": "BETA2"
      }
    ]
  },
  "pack_files": [
    "tasks/_assembly.py",
    "tasks/_common.py",
    "tasks/lion/__init__.py",
    "tasks/lion/kernel_triton.py",
    "tasks/lion/naive.metal",
    "tasks/lion/opspec.json",
    "tasks/lion/task.py",
    "tasks/lion/track.json",
    "tcenv/backends/metal/lowering.py",
    "tcenv/contract.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/task.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json"
  ]
}
