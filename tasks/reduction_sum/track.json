{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/reduction_sum/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-reduction-sum",
  "spec_text": {
    "template": "tasks/reduction_sum/kernel_triton.py",
    "placeholders": {
      "M": "spec_params",
      "N": "spec_params",
      "TL": "dtype_spelling"
    }
  },
  "known_good": {
    "template": "tasks/reduction_sum/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "y[r] = sum_c x[r, c], accumulated in fp32 (inputs may cancel catastrophically) and rounded once to the element type.",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "reduction_sum.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mags": {
          "normal": 1.0,
          "wide_range": 0.1
        },
        "default_mag": 1.0,
        "large": 300.0
      }
    },
    "reference": {
      "implementation_id": "reduction_sum.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "float64",
        "axis": "last"
      }
    },
    "error_scale": {
      "implementation_id": "reduction_sum.error_scale",
      "implementation_version": 1,
      "params": {
        "scale": "sum_abs_rows"
      }
    }
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "reduction_sum.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "kernel": "mx.sum",
        "axis": "last"
      }
    },
    {
      "name": "torch_mps",
      "framework": "torch",
      "implementation_id": "reduction_sum.baseline.torch_mps",
      "implementation_version": 1,
      "params": {
        "kernel": "torch.sum",
        "dim": "last"
      }
    }
  ],
  "pack_files": [
    "tcenv/backends/metal/lowering.py",
    "tcenv/distributions.py",
    "tcenv/dtypes.py",
    "tcenv/identity.py",
    "tcenv/lowering.py",
    "tcenv/opspec/__init__.py",
    "tcenv/opspec/model.py",
    "tcenv/opspec/schema/opspec.v1.schema.json",
    "tcenv/opspec/validator.py",
    "tcenv/track/__init__.py",
    "tcenv/track/schema/track.v1.schema.json",
    "tasks/_assembly.py",
    "tasks/reduction_sum/__init__.py",
    "tasks/reduction_sum/kernel_triton.py",
    "tasks/reduction_sum/naive.metal",
    "tasks/reduction_sum/opspec.json",
    "tasks/reduction_sum/task.py",
    "tasks/reduction_sum/track.json"
  ],
  "template_literals": {
    "launch": [
      {
        "template": "tasks/reduction_sum/kernel_triton.py",
        "text": "num_warps = 4",
        "threads_per_threadgroup": 128
      },
      {
        "template": "tasks/reduction_sum/naive.metal",
        "text": "i += 128",
        "threads_per_threadgroup": 128
      }
    ],
    "semantic": []
  }
}
