{
  "track": "triton-spec-to-msl",
  "opspec": "tasks/mamba2_chunk_scan/opspec.json",
  "backend_id": "metal",
  "lowering_profile": "metal-mamba2-chunk-scan",
  "spec_text": {
    "template": "tasks/mamba2_chunk_scan/kernel_triton.py",
    "placeholders": {
      "BATCH": "spec_params",
      "SEQLEN": "spec_params",
      "NHEADS": "spec_params",
      "HEADDIM": "spec_params",
      "DSTATE": "spec_params",
      "CHUNK": "spec_params",
      "NCHUNKS": "spec_params",
      "TL": "dtype_spelling",
      "NW": "backend_params"
    }
  },
  "known_good": {
    "template": "tasks/mamba2_chunk_scan/naive.metal",
    "placeholders": {
      "T": "dtype_spelling"
    }
  },
  "description": "Mamba-2 (SSD) chunk scan for one B/C group: per (batch, head, chunk) of CHUNK time steps, y[t] = sum_{s<=t} (C[t].B[s]) exp(cs[t]-cs[s]) dt[s] x[s] + exp(cs[t]) (C[t] . state[p]) + D x[t] (fp32 math, result rounded once); only the causal terms s <= t of the chunk exist (nothing is multiplied by a masked zero).",
  "dtype_spelling": {
    "fp16": {
      "T": "half",
      "TL": "tl.float16",
      "TORCH": "torch.float16"
    },
    "bf16": {
      "T": "bfloat",
      "TL": "tl.bfloat16",
      "TORCH": "torch.bfloat16"
    }
  },
  "implementations": {
    "gen_inputs": {
      "implementation_id": "mamba2_chunk_scan.gen_inputs",
      "implementation_version": 1,
      "params": {
        "mags": {
          "normal": 1.0,
          "wide_range": 0.1
        },
        "default_mag": 1.0,
        "large": 4.0,
        "spike": 5.0,
        "seed_offsets": {
          "x": 0,
          "Bmat": 31,
          "Cmat": 62,
          "Dskip": 124,
          "states": 93,
          "dt": 155,
          "decay": 186
        },
        "dt_range": [
          0.001,
          0.05
        ],
        "decay_range": [
          1.0,
          8.0
        ]
      }
    },
    "reference": {
      "implementation_id": "mamba2_chunk_scan.reference",
      "implementation_version": 1,
      "params": {
        "accumulate": "double",
        "ops": "ssd_chunk_scan",
        "half": false
      }
    },
    "error_scale": null
  },
  "baselines": [
    {
      "name": "mlx",
      "framework": "mlx",
      "implementation_id": "mamba2_chunk_scan.baseline.mlx",
      "implementation_version": 1,
      "params": {
        "ops": "ssd_chunk_scan",
        "half": false,
