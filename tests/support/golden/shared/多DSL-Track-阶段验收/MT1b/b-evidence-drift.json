    "closed_verifiers_affected": [],
    "manifest_pins": "B1-B4 ship no manifest.sha256 and no verify.py; only boundary.json, compare.py and prose",
    "prose_pins": "B1.md/B2.md describe the slices as 'status=ok, ABI/correctness pass, timing > 0'; they quote no median",
    "semantic_effect": "none observed: same candidate/geometry/bundle/artifact-set identities, same dispatch, still correct",
    "performance_effect": "the archived medians moved (e.g. lion 8.002976842579388 -> 1.6428749842345025 us); B* explicitly does not publish performance, and MT1b publishes none"
  },
  "boundary": [
    "no MT1b file changed, and no MT1b claim depends on, these nine files",
    "identity.json.changed_files deliberately does not list them",
    "the verifier refuses an identity that claims one of them as an MT1b edit",
    "the bytes were NOT reverted: reverting would overwrite another session's real Metal output with git content"
  ],
  "required_action": "Operator decision, outside MT1b: either accept this fresh re-record as the current B* evidence (a new B* epoch, since the archived medians moved) or restore the HEAD bytes in that new epoch.  Both need a human/GPU-authorized step; MT1b neither performs nor legitimises either.",
  "reproduce": "for f in <paths>: git cat-file -p HEAD:$f > /tmp/a.json; python -c \"import json,sys;a=json.load(open('/tmp/a.json'));b=json.load(open('$f'));print([k for k in a if a[k]!=b.get(k)])\"   # prints ['median_us'] for all nine"
}
