  "adopted_route": "existing_abi_workspace_serial_stages",
  "concurrency_note": "the permitted Metal synchronization model is a serial encoder plus a buffer barrier between stages, so cutting one chain into pieces adds stages and threadgroups but never runs two pieces of the same chain at the same time; a cross-threadgroup spin would be a deadlock risk and is not accepted as evidence",
  "epoch": "p2-q-seq-state-handoff-1",
  "implementation_changed": false,
  "npu_simulated_only": true,
