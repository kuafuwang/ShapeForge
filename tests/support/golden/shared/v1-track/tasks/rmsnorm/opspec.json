{
  "spec_version": 2,
  "op_name": "rmsnorm",
  "category": "normalization",
  "formula": "y[r,:] = x[r,:] * rsqrt(mean(x[r,:]^2, axis=H) + EPS) * w",
  "type_vars": {
    "T": [
      "fp16",
      "bf16"
    ]
  },
  "symbols": {
    "M": {
      "min": 0
    },
    "H": {
      "min": 1,
      "note": "非整除也必须覆盖；tail 由 mask/循环边界处理"
    }
  },
  "tensors": {
    "x": {
      "role": "input",
      "dims": [
        "M",
        "H"
      ],
      "dtype": "T",
      "layout": "row_major",
      "strides": [
        "H",
        "1"
      ],
      "space": "global",
      "access": "read",
      "doc": "activations, row-major [M, H]"
    },
    "w": {
      "role": "input",
      "dims": [
        "H"
      ],
      "dtype": "T",
      "layout": "contiguous",
      "strides": [
        "1"
      ],
      "space": "global",
      "access": "read",
      "doc": "per-channel weight"
    },
    "y": {
      "role": "output",
      "dims": [
        "M",
        "H"
      ],
      "dtype": "T",
      "layout": "row_major",
      "strides": [
        "H",
        "1"
      ],
      "space": "global",
      "access": "write"
    }
  },
  "numerics": {
    "acc_dtype": "fp32",
    "rounding": "single_round_at_output",
    "tolerances": {
      "fp16": {
        "rtol": 0.002,
        "atol_rel": 0.001
      },
      "bf16": {
        "rtol": 0.016,
        "atol_rel": 0.008
      }
    },
    "exact": false
  },
  "attrs": {
    "EPS": {
      "dtype": "float",
      "default": 1e-06,
      "domain": {
        "gt": 0
      },
      "doc": "numerical floor added to the mean of squares"
    }
  },
  "cases": {
    "names": [
      "normal",
      "wide_range",
      "large",
      "tiny",
      "outlier",
      "ieee"
    ]
  },
  "sizes": {
    "paper": {
      "M": 4096,
      "H": 4096,
      "usage": [
        "golden",
        "benchmark"
      ]
    },
    "small": {
      "M": 64,
      "H": 512,
      "usage": [
        "golden",
        "benchmark"
      ]
    }
  },
  "spec_params": [
    "M",
    "H"
  ],
  "work_accounting": {
    "flops": {
      "terms": [
        {
          "coefficient": 4,
          "symbols": [
            "M",
            "H"
          ]
        }
      ]
    },
    "min_bytes": {
      "terms": [
        {
          "tensor": "x"
        },
        {
          "tensor": "y"
        },
        {
          "tensor": "w"
        }
      ]
    }
  },
  "discovery": {
    "phase": 1,
    "default_instance": {
      "dtype": "fp16",
      "size": "small"
    }
  }
}
