{
  "spec_version": 2,
  "op_name": "sem_gelu_named_relu",
  "category": "elementwise",
  "formula": "y[i] = 0.5 * x * (1 + tanh(GELU_C * (x + GELU_K * x^3))), tanh approximation (as written; the header comment and docstring say ReLU)",
  "type_vars": {
    "T": [
      "fp16",
      "bf16"
    ]
  },
  "symbols": {
    "N": {
      "min": 1
    }
  },
  "tensors": {
    "x": {
      "role": "input",
      "dims": [
        "N"
      ],
      "dtype": "T",
      "layout": "contiguous",
      "strides": [
        "1"
      ],
      "space": "global",
      "access": "read"
    },
    "y": {
      "role": "output",
      "dims": [
        "N"
      ],
      "dtype": "T",
      "layout": "contiguous",
      "strides": [
        "1"
      ],
      "space": "global",
      "access": "write"
    }
  },
  "numerics": {
    "acc_dtype": "fp32",
    "rounding": "single_round_at_output",
    "tolerances": {
      "fp16": {
        "rtol": 0.002,
        "atol_rel": 0.001
      },
      "bf16": {
        "rtol": 0.016,
        "atol_rel": 0.008
      }
    },
    "exact": false
  },
  "attrs": {
    "GELU_C": {
      "dtype": "float",
      "default": 0.7978845608028654,
      "domain": {
        "gt": 0
      },
      "doc": "sqrt(2/pi) coefficient of the tanh approximation as written in the body"
    },
    "GELU_K": {
      "dtype": "float",
      "default": 0.044715,
      "domain": {
        "gt": 0
      },
      "doc": "cubic coefficient of the tanh approximation as written in the body"
    }
  },
  "cases": {
    "names": [
      "normal",
      "wide_range",
      "large",
      "tiny",
      "outlier",
      "ieee"
    ],
    "inputs": {}
