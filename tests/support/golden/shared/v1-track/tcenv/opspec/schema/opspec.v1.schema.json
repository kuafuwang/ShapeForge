{
  "$comment": "Registered structural schema for OpSpec v1 (plan §3.1/§4.1). Semantic rules (uses completeness, attr domains, shape and usage constraints, work accounting) are checked by tcenv.opspec.model; this document only fixes the tree shape and closed key set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "op_name",
    "category",
    "formula",
    "uses",
    "type_vars",
    "symbols",
    "tensors",
    "numerics",
    "attrs",
    "cases",
    "sizes",
    "spec_params",
    "work_accounting"
  ],
  "properties": {
    "spec_version": {
      "type": "integer",
      "const": 1
    },
    "op_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[a-z][a-z0-9_]*"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[a-z][a-z0-9_]*"
    },
    "formula": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "[A-Z][A-Z0-9_]*"
      },
      "maxItems": 64
    },
    "type_vars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "T"
      ],
      "properties": {
        "T": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "fp16",
              "bf16",
              "fp32",
              "i8",
              "i32",
              "u8",
              "u32"
            ]
          }
        }
      }
    },
    "symbols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "tensors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dims",
          "dtype",
          "layout",
          "strides",
          "space",
          "access"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "input",
              "output"
            ]
          },
          "dims": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "dtype": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "layout": {
            "type": "string",
            "enum": [
              "row_major",
              "contiguous",
              "strided"
            ]
          },
          "strides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "space": {
            "type": "string",
            "enum": [
              "global"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "read_write"
            ]
          },
          "doc": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acc_dtype",
        "rounding",
        "tolerances",
        "exact"
      ],
      "properties": {
        "acc_dtype": {
          "type": "string",
          "enum": [
            "fp16",
            "bf16",
            "fp32",
            "i32"
          ]
        },
        "rounding": {
          "type": "string",
          "enum": [
            "single_round_at_output",
            "per_operation",
            "exact_integer"
          ]
        },
        "tolerances": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rtol",
              "atol_rel"
            ],
            "properties": {
              "rtol": {
                "type": "number",
                "minimum": 0
              },
              "atol_rel": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "attrs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dtype"
        ],
        "properties": {
          "dtype": {
            "type": "string",
            "enum": [
              "float",
              "int"
            ]
          },
          "default": {
            "type": [
              "number",
              "integer"
            ]
          },
          "domain": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "gt": {
                "type": "number"
              },
              "ge": {
                "type": "number"
              },
              "lt": {
                "type": "number"
              },
              "le": {
                "type": "number"
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "number",
                    "integer"
                  ]
                }
              }
            }
          },
          "doc": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[A-Za-z][A-Za-z0-9_]*"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "number",
                "integer",
                "string",
                "boolean",
                "array",
                "object"
              ]
            }
          }
        }
      }
    },
    "sizes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object"
      }
    },
    "spec_params": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "work_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flops",
        "min_bytes"
      ],
      "properties": {
        "flops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terms"
          ],
          "properties": {
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "coefficient": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "symbols": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "tensor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "literal": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "min_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terms"
          ],
          "properties": {
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "coefficient": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "symbols": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "tensor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "literal": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "block",
        "rules",
        "statements",
        "final"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "int32-block-program"
          ]
        },
        "block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "dst",
              "a"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "bin",
                  "sbin",
                  "shl",
                  "shr",
                  "mod",
                  "where",
                  "neg",
                  "hash",
                  "loop",
                  "sum",
                  "max",
                  "min"
                ]
              },
              "dst": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "[a-z][a-z0-9_]*"
              },
              "a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "b": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "c": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "d": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "op": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              },
              "const": {
                "type": "integer"
              },
              "rounds": {
                "type": "integer"
              }
            }
          }
        },
        "final": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "arithmetic",
            "mod_mask",
            "hash_shift",
            "loop_shift",
            "index_mask",
            "shl_range",
            "shr_range",
            "wrap_kinds",
            "plain_kinds"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "arithmetic": {
              "type": "string",
              "enum": [
                "int32_twos_complement"
              ]
            },
            "mod_mask": {
              "type": "integer",
              "minimum": 0
            },
            "hash_shift": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "loop_shift": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "index_mask": {
              "type": "integer",
              "minimum": 0
            },
            "shl_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            },
            "shr_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            },
            "wrap_kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "bin",
                  "sbin",
                  "shl",
                  "shr",
                  "mod",
                  "where",
                  "neg",
                  "hash",
                  "loop",
                  "sum",
                  "max",
                  "min"
                ]
              }
            },
            "plain_kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "bin",
                  "sbin",
                  "shl",
                  "shr",
                  "mod",
                  "where",
                  "neg",
                  "hash",
                  "loop",
                  "sum",
                  "max",
                  "min"
                ]
              }
            }
          }
        }
      }
    }
  }
}
